              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "type": "array",
            "title": "Entity Ids"
          },
          "operation_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "type": "array",
            "title": "Operation Ids"
          },
          "start_s": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start S"
          },
          "end_s": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End S"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code",
          "severity",
          "entity_ids",
          "operation_ids",
          "start_s",
          "end_s",
          "message"
        ],
        "title": "Conflict"
      },
      "ControlCommand": {
        "properties": {
          "command_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Command Id"
