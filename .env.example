# Local development only. Replace the password before starting PostgreSQL.
POSTGRES_USER=uzel12
POSTGRES_DB=uzel12
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://uzel12:replace-with-random-local-password@localhost:5432/uzel12
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DB_POOL_MAX_SIZE=4
DB_TIMEOUT_S=3
SCENARIO_PATH=shared/scenarios/one_train.json
PLANNER_TIMEOUT_S=5
PLANNER_BUDGET_S=2

# --- Stage 6: access control (docs/auth.md). Never commit real values. ---
# PYTHONPATH=backend; python -m app.auth generate-secret   -> SESSION_SECRET (>= 32 chars)
# PYTHONPATH=backend; python -m app.auth hash-password     -> *_PASSWORD_HASH (input hidden)
# An empty hash disables that account; without SESSION_SECRET login answers 503.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
DISPATCHER_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=
# Local plain-HTTP development only. Remove (default true) when served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
SESSION_TTL_S=28800
WS_SESSION_RECHECK_S=10
